                                    </TabControl>
                                </Border>
                                <StackPanel Width="540" Margin="1,3,0,0">
                                    <Border Height="704" Width="540" Background="#7F4E4E4E" CornerRadius="5,5,5,5">
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="540" Margin="6,6,6,6">
                                            <StackPanel Height="18" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Label Content="Gateway Log" FontFamily="Arial Black" FontSize="12" Height="15" Width="130" Padding="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                                                <styles:SHButtonPrimary x:Name="btn_clear_log" Click="btn_clear_log_Click" Width="55" Height="15" Content="Clear" HorizontalAlignment="Left" Margin="6,0,0,0" Padding="4,0,4,0" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="9" />
                                            </StackPanel>
                                            <TextBlock x:Name="TextBlock_Status" Height="20" Width="520" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Background="#00252525" FontSize="9" FontFamily="Arial" Padding="4,2,4,0" />
                                            <StackPanel Orientation="Horizontal" Width="520" Margin="0,4,0,0">
                                                <Label Content="Sources:" FontFamily="Arial" FontSize="9" Height="16" Width="55" Padding="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding LogSourceFilters}" Width="465">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" FontFamily="Arial" FontSize="9" VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <ListBox x:Name="ListBox_UiLog" Width="520" Margin="0,4,0,0" Background="#00252525" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding UiLogView}" Panel.ZIndex="-3">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="1,-4,1,-4">
                                                            <TextBox Text="{Binding Time}" Width="60" FontSize="8" Foreground="#99FFFFFF" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" MinHeight="0" IsReadOnly="True" VerticalContentAlignment="Center" />
                                                            <TextBox Text="{Binding Level}" Width="60" FontSize="8" Foreground="#FFB6C3D1" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" MinHeight="0" IsReadOnly="True" VerticalContentAlignment="Center" />
                                                            <TextBox Text="{Binding Source}" Width="80" FontSize="8" Foreground="#A5D2D2D2" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" MinHeight="0" IsReadOnly="True" VerticalContentAlignment="Center" />
                                                            <TextBox Text="{Binding Message}" FontSize="8" TextWrapping="Wrap" Width="300" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" MinHeight="0" IsReadOnly="True" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
