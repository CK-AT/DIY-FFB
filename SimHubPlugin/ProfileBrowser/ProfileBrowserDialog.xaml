<Window x:Class="DiyFfb.ProfileBrowser.ProfileBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Manager"
        MinHeight="540"
        Width="731"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B"
        Foreground="White"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TextTitle"
                   Grid.Row="0"
                   Text="Profile Manager"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#DDDDDD"
                   Margin="0,0,0,12" />

        <!-- Tab bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RadioTemplates"
                         Content="Templates"
                         GroupName="TabGroup"
                         IsChecked="True"
                         Checked="OnTabChanged"
                         Foreground="White"
                         Margin="0,0,16,0"
                         VerticalContentAlignment="Center"/>
            <RadioButton x:Name="RadioMyVehicles"
                         Content="My Vehicles"
                         GroupName="TabGroup"
                         Checked="OnTabChanged"
                         Foreground="White"
                         Margin="0,0,16,0"
                         VerticalContentAlignment="Center"/>
            <RadioButton x:Name="RadioCustom"
                         Content="Custom"
                         GroupName="TabGroup"
                         Checked="OnTabChanged"
                         Foreground="White"
                         Margin="0,0,16,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Graph files you've copied into the plugin's custom library."/>
            <Button x:Name="ButtonImport"
                    Content="Import..."
                    Click="OnImportClick"
                    Padding="8,4"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"/>
            <Button x:Name="ButtonCustomGraph"
                    Content="Custom Graph..."
                    Click="OnBrowseCustomGraphClick"
                    Margin="8,0,0,0"
                    Padding="8,4"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"
                    ToolTip="Assign an arbitrary graph .json file to the current vehicle."/>
        </StackPanel>

        <!-- Filter row: game filter (My Vehicles only) + always-visible search -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel x:Name="PanelGameFilter"
                        Orientation="Horizontal"
                        Margin="0,0,16,0"
                        Visibility="Collapsed">
                <TextBlock Text="Game:"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="ComboGameFilter"
                          Width="200"
                          Background="#2A2A2A"
                          Foreground="White"
                          BorderBrush="#4A4A4A"
                          SelectionChanged="OnGameFilterChanged"/>
            </StackPanel>
            <TextBlock Text="Search:"
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox"
                     Width="220"
                     Background="#2A2A2A"
                     Foreground="White"
                     BorderBrush="#4A4A4A"
                     VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged"/>
        </StackPanel>

        <!-- Apply target (pinned above the list). Fixed height so the list does
             not jump as selection changes; content swaps between the active card
             (exactly one selected) and a hint (zero or many selected). -->
        <Border x:Name="BorderApplyTarget"
                Grid.Row="3"
                Background="#212821"
                BorderBrush="#3A6A3A"
                BorderThickness="1"
                Padding="10,8"
                Margin="0,0,0,8"
                MinHeight="70">
            <Grid>
                <!-- Active: exactly one profile selected -->
                <Grid x:Name="PanelApplyActive" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TextApplyName"
                                   Text="-"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock x:Name="TextApplyInfo"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#9A9A9A"
                                   Margin="0,1,0,0" />
                        <TextBlock x:Name="TextGraphMissing"
                                   FontSize="10"
                                   Foreground="#E0A020"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox x:Name="CheckUseGraph"
                                      Content="Use graph"
                                      Foreground="#DDDDDD"
                                      VerticalContentAlignment="Center"
                                      Checked="OnApplyToggleChanged"
                                      Unchecked="OnApplyToggleChanged"/>
                            <CheckBox x:Name="CheckCopyTuning"
                                      Content="Copy graph tuning"
                                      Foreground="#DDDDDD"
                                      VerticalContentAlignment="Center"
                                      Margin="18,0,0,0"
                                      Checked="OnApplyToggleChanged"
                                      Unchecked="OnApplyToggleChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="CheckCopyFunctionTuning"
                                      Content="Copy function tuning"
                                      Foreground="#DDDDDD"
                                      VerticalContentAlignment="Center"
                                      Checked="OnApplyToggleChanged"
                                      Unchecked="OnApplyToggleChanged"/>
                            <CheckBox x:Name="CheckCopySimVarBindings"
                                      Content="Copy sim-var bindings"
                                      Foreground="#DDDDDD"
                                      VerticalContentAlignment="Center"
                                      Margin="18,0,0,0"
                                      Checked="OnApplyToggleChanged"
                                      Unchecked="OnApplyToggleChanged"/>
                            <CheckBox x:Name="CheckCopyActiveFunctions"
                                      Content="Copy active functions"
                                      Foreground="#DDDDDD"
                                      VerticalContentAlignment="Center"
                                      Margin="18,0,0,0"
                                      Checked="OnApplyToggleChanged"
                                      Unchecked="OnApplyToggleChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="TextGraphMismatch"
                                   FontSize="10"
                                   Foreground="#E0A020"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="TextApplyWarning"
                                   Text="Source and destination are the same vehicle — nothing to apply."
                                   FontSize="10"
                                   Foreground="#E0A020"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Manage mode: choose which vehicle profile receives the apply -->
                        <StackPanel x:Name="PanelDestinationCombo" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock Text="Apply to:"
                                       FontSize="10"
                                       Foreground="#9A9A9A"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,2"/>
                            <ComboBox x:Name="ComboDestination"
                                      Width="190"
                                      DisplayMemberPath="Label"
                                      Background="#2A2A2A"
                                      Foreground="White"
                                      BorderBrush="#4A4A4A"
                                      SelectionChanged="OnDestinationChanged"/>
                        </StackPanel>
                        <!-- Locked modes: static destination (the active vehicle) -->
                        <TextBlock x:Name="TextApplyDestination"
                                   Text=""
                                   FontSize="10"
                                   Foreground="#9A9A9A"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,4"/>
                        <Button x:Name="ButtonApply"
                                Content="Apply"
                                Width="110"
                                HorizontalAlignment="Right"
                                Click="OnApplyClick"
                                IsDefault="True"
                                Background="#4A7A4A"
                                Foreground="White"
                                BorderBrush="#5A9A5A"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <!-- Hint: zero or many selected -->
                <TextBlock x:Name="TextApplyHint"
                           Text="Select a profile to apply, or profiles to delete / export."
                           Foreground="#888888"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <!-- No active vehicle: nothing to apply to -->
                <StackPanel x:Name="PanelApplyNoVehicle"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="&#9888;"
                               FontSize="16"
                               Foreground="#E0A020"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="No active vehicle — start a session to apply a profile. You can still delete or export below."
                               Foreground="#E0A020"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               MaxWidth="560"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="4"
                Background="#1E1E1E"
                BorderBrush="#4A4A4A"
                BorderThickness="1">
            <ListBox x:Name="ListItems"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     SelectionMode="Extended"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnItemDoubleClick"
                     KeyDown="OnListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8,10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2A2A2A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3A3A3A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="White"
                                               VerticalAlignment="Center" />
                                    <Border Background="#3A6A3A"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Current"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#DFF5DF" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding GameId}"
                                           FontSize="10"
                                           Foreground="#888888"
                                           Margin="0,0,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameId}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GameId}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="#AAAAAA"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GraphName}"
                                       FontSize="11"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="Tuned"
                                       FontSize="11"
                                       Foreground="#88CC88"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasTuning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Action bar: manage actions (multi-selection) on the left, dismiss on
             the right. The Apply action lives in the pinned target card above. -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ButtonSaveToLibrary"
                        Content="Save to Library"
                        Width="110"
                        Margin="0,0,8,0"
                        Click="OnSaveToLibraryClick"
                        Background="#4A5A6A"
                        Foreground="White"
                        BorderBrush="#5A7A9A"
                        Visibility="Collapsed"/>
                <Button x:Name="ButtonDeleteSelected"
                        Content="Delete"
                        Width="80"
                        Margin="0,0,8,0"
                        Click="OnDeleteSelectedClick"
                        Background="#6A4A4A"
                        Foreground="White"
                        BorderBrush="#9A5A5A"
                        Visibility="Collapsed"/>
                <Button x:Name="ButtonExport"
                        Content="Export..."
                        Width="90"
                        Click="OnExportClick"
                        Background="#3A3A3A"
                        Foreground="White"
                        BorderBrush="#5A5A5A"/>
            </StackPanel>
            <Button x:Name="ButtonCancel"
                    Content="Cancel"
                    Width="80"
                    HorizontalAlignment="Right"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Background="#3A3A3A"
                    Foreground="White"
                    BorderBrush="#5A5A5A"/>
        </Grid>
    </Grid>
</Window>
